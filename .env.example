# ── Contact form (server-only) ─────────────────────────────────────────────
# Gmail SMTP. Without these, the form accepts submissions but emails nothing.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=

# ── Cloudflare Turnstile (contact-form anti-spam) ──────────────────────────
# Set BOTH to enable the widget + server verification. Leave blank to rely on
# the honeypot + rate-limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── PostHog analytics (ADR-0002) ───────────────────────────────────────────
# Leave the key blank to disable analytics entirely (no network, no cookies).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
